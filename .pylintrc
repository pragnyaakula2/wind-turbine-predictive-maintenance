[MAIN]
ignore=venv,.venv,.git,data,models,results
jobs=0

[MESSAGES CONTROL]
disable=
    raw-checker-failed,
    bad-inline-option,
    locally-disabled,
    file-ignored,
    suppressed-message,
    useless-suppression,
    deprecated-pragma,
    use-symbolic-message-instead,
    too-many-locals,
    too-many-statements,
    too-many-branches,
    duplicate-code,
    trailing-newlines

[FORMAT]
max-line-length=100
